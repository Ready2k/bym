.venv/
__pycache__/
*.pyc
*.egg-info/
.DS_Store
# The Football-Data corpus, at the repo root only. Anchored deliberately:
# an unanchored `data/` matches a directory of that name at ANY depth, and
# silently excluded the whole of src/bym/data/ — the Football-Data
# ingestion package — from the repository. web.py and cli.py import it at
# module level, so a fresh clone could not import bym at all.
/data/
research/data/
secrets/
.pytest_cache/
.run/
config/odds_api_quota.json
*.db
config/*_quota.json
.env

#API Keys
secrets/research/data/

# Round files are this week's Sky fixture selection and deadline, not
# code — they churn weekly and carry no history worth keeping. The one
# tracked exception is the template a fresh clone copies to start.
/rounds/*.json
!/rounds/example_round.json

# ingore the CLAUDE.md file, which is a personal note for the author and not relevant to the project
CLAUDE.md
