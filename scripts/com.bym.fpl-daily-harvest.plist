<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template — launchd requires absolute paths baked in, so this is not
     installed as-is. Run scripts/install_fpl_harvest_launchd.sh, which
     substitutes __REPO_DIR__ for wherever the repo actually lives and
     installs the result into ~/Library/LaunchAgents/. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.bym.fpl-daily-harvest</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__REPO_DIR__/scripts/fpl_daily_harvest_wrapper.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>1</integer>
        <key>Minute</key>
        <integer>15</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>__REPO_DIR__/data/fpl_daily_harvest_launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO_DIR__/data/fpl_daily_harvest_launchd.err.log</string>
</dict>
</plist>
